<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="8" author="xiaozhi">
        <comment>音色表</comment>
        <createTable tableName="timbre" remarks="音色资源表">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)" remarks="音色名称"/>
            <column name="voice_code" type="varchar(100)" remarks="音色编码"/>
            <column name="provider" type="varchar(50)" remarks="供应商"/>
            <column name="description" type="varchar(500)" remarks="描述"/>
            <column name="sample_audio" type="varchar(500)" remarks="试听音频URL"/>
            <column name="category" type="varchar(20)" remarks="分类"/>
            <column name="language" type="varchar(10)" remarks="语言"/>
            <column name="status" type="tinyint" defaultValue="1" remarks="状态"/>
            <column name="create_date" type="datetime" remarks="创建时间"/>
            <column name="update_date" type="datetime" remarks="更新时间"/>
            <column name="creator" type="bigint" remarks="创建者"/>
            <column name="updater" type="bigint" remarks="更新者"/>
        </createTable>

        <createTable tableName="voice_clone" remarks="声音克隆表">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)" remarks="克隆名称"/>
            <column name="voice_code" type="varchar(100)" remarks="音色编码"/>
            <column name="reference_audio" type="varchar(500)" remarks="参考音频路径"/>
            <column name="description" type="varchar(500)" remarks="描述"/>
            <column name="status" type="varchar(20)" defaultValue="pending" remarks="状态"/>
            <column name="error_msg" type="varchar(500)" remarks="错误信息"/>
            <column name="create_date" type="datetime" remarks="创建时间"/>
            <column name="update_date" type="datetime" remarks="更新时间"/>
            <column name="creator" type="bigint" remarks="创建者"/>
            <column name="updater" type="bigint" remarks="更新者"/>
        </createTable>

        <createTable tableName="agent_template" remarks="智能体模板表">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)" remarks="模板名称"/>
            <column name="description" type="varchar(500)" remarks="描述"/>
            <column name="system_prompt" type="text" remarks="系统提示词"/>
            <column name="category" type="varchar(20)" remarks="分类"/>
            <column name="avatar" type="varchar(500)" remarks="头像"/>
            <column name="default_wake_words" type="varchar(500)" remarks="默认唤醒词"/>
            <column name="default_voice" type="varchar(100)" remarks="推荐音色"/>
            <column name="sort" type="int" defaultValue="0" remarks="排序"/>
            <column name="status" type="tinyint" defaultValue="1" remarks="状态"/>
            <column name="create_date" type="datetime" remarks="创建时间"/>
            <column name="update_date" type="datetime" remarks="更新时间"/>
            <column name="creator" type="bigint" remarks="创建者"/>
            <column name="updater" type="bigint" remarks="更新者"/>
        </createTable>
    </changeSet>

