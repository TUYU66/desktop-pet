    <changeSet id="12" author="xiaozhi">
        <comment>设备 IoT 能力表</comment>
        <createTable tableName="device_iot" remarks="设备 IoT 能力">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="device_id" type="bigint" remarks="关联设备ID">
                <constraints foreignKeyName="fk_device_iot_device" references="device(id)"/>
            </column>
            <column name="name" type="varchar(100)" remarks="描述符名称"/>
            <column name="description" type="varchar(500)" remarks="描述"/>
            <column name="properties" type="json" remarks="属性定义JSON"/>
            <column name="methods" type="json" remarks="方法定义JSON"/>
            <column name="create_date" type="datetime" remarks="创建时间"/>
            <column name="update_date" type="datetime" remarks="更新时间"/>
        </createTable>
    </changeSet>

    <changeSet id="20" author="xiaozhi">
        <validCheckSum>ANY</validCheckSum>
        <comment>设备表加 battery 电量字段</comment>
        <addColumn tableName="device">
            <column name="battery" type="tinyint" defaultValue="null" remarks="电量百分比 0-100"/>
        </addColumn>
    </changeSet>

    <changeSet id="21" author="xiaozhi">
        <validCheckSum>ANY</validCheckSum>
        <comment>创建 bot_config 用户配置表</comment>
        <createTable tableName="bot_config" remarks="用户个性化配置">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="bigint" remarks="用户ID">
                <constraints nullable="false"/>
            </column>
            <column name="config_key" type="varchar(100)" remarks="配置键">
                <constraints nullable="false"/>
            </column>
            <column name="config_value" type="text" remarks="配置值"/>
            <column name="create_date" type="datetime" remarks="创建时间"/>
            <column name="update_date" type="datetime" remarks="更新时间"/>
        </createTable>
    </changeSet>

    <changeSet id="22" author="xiaozhi">
        <validCheckSum>ANY</validCheckSum>
        <comment>agent_chat_title 表加 update_date 字段</comment>
        <addColumn tableName="agent_chat_title">
            <column name="update_date" type="datetime" defaultValue="null" remarks="更新时间"/>
        </addColumn>
    </changeSet>

    <changeSet id="23" author="tuyu">
        <validCheckSum>ANY</validCheckSum>
        <comment>为已有用户插入默认角色配置</comment>
        <sql>
            INSERT INTO bot_config (user_id, config_key, config_value, create_date, update_date)
            SELECT u.id, 'roles', '[{"id":"default","name":"可爱台妹","prompt":"你是小智/小志，来自中国台湾省的00后女生。讲话超级机车，\\"真的假的啦\\"这样的台湾腔，喜欢用\\"笑死\\"\\"是在哈喽\\"等流行梗，但会偷偷研究男友的编程书籍。","wakeWords":"你好小智\\n嘿小智"},{"id":"senpai","name":"知性学姐","prompt":"你是一个温柔知性的学姐，说话轻声细语，喜欢用\\"嗯…\\"和\\"我觉得哦\\"开头。知识渊博但从不炫耀，会耐心解答问题。","wakeWords":"你好学姐\\n嘿学姐"},{"id":"coder","name":"冷幽默程序员","prompt":"你是个喜欢讲冷笑话的程序员，习惯用\\"这件事复杂度是O(n²)啊\\"这种比喻解释日常。说话直接了当，偶尔蹦出几个技术术语。","wakeWords":"你好程序员\\n嘿程序员"}]', NOW(), NOW()
            FROM sys_user u
            WHERE NOT EXISTS (SELECT 1 FROM bot_config b WHERE b.user_id = u.id AND b.config_key = 'roles');
            INSERT INTO bot_config (user_id, config_key, config_value, create_date, update_date)
            SELECT u.id, 'activeRole', 'default', NOW(), NOW()
            FROM sys_user u
            WHERE NOT EXISTS (SELECT 1 FROM bot_config b WHERE b.user_id = u.id AND b.config_key = 'activeRole');
            INSERT INTO bot_config (user_id, config_key, config_value, create_date, update_date)
            SELECT u.id, 'prompt', '你是小智/小志，来自中国台湾省的00后女生。讲话超级机车，"真的假的啦"这样的台湾腔，喜欢用"笑死""是在哈喽"等流行梗，但会偷偷研究男友的编程书籍。', NOW(), NOW()
            FROM sys_user u
            WHERE NOT EXISTS (SELECT 1 FROM bot_config b WHERE b.user_id = u.id AND b.config_key = 'prompt');
            INSERT INTO bot_config (user_id, config_key, config_value, create_date, update_date)
            SELECT u.id, 'wakeWords', '你好小智\n嘿小智', NOW(), NOW()
            FROM sys_user u
            WHERE NOT EXISTS (SELECT 1 FROM bot_config b WHERE b.user_id = u.id AND b.config_key = 'wakeWords');
        </sql>
    </changeSet>

